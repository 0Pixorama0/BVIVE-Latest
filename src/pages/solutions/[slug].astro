---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import SolutionMock from "../../components/mock/SolutionMock.astro";
import CTASection from "../../components/CTASection.astro";
import Faq from "../../components/Faq.astro";
import { solutions, pillars } from "../../data/site";

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { sol: s } }));
}
const { sol } = Astro.props;
const others = solutions.filter((s) => s.slug !== sol.slug).slice(0, 3);
const pillar = pillars.find((p) => p.key === sol.pillar)!;
---
<Layout title={sol.title} description={sol.sub}>
  <PageHero
    eyebrow={sol.eyebrow}
    title={sol.hero}
    sub={sol.sub}
    crumb={{ label: "All solutions", href: "/solutions" }}
  >
    <a href="/book-demo" class="btn btn--primary">Book a Demo <Icon name="arrow" size={17} class="btn__icon" /></a>
    <a href="/platform" class="btn btn--ghost">See the platform</a>
  </PageHero>

  <!-- problem → outcome + mock -->
  <section class="section split">
    <div class="container">
      <div class="split__grid">
        <div class="split__copy" data-reveal>
          <span class="eyebrow">Before &amp; after</span>
          <div class="ba">
            <div class="ba__card ba__card--before">
              <span class="ba__tag ba__tag--before"><Icon name="close" size={13} /> Without Bvive</span>
              <p>{sol.problem}</p>
            </div>
            <div class="ba__arrow"><Icon name="arrow" size={20} /></div>
            <div class="ba__card ba__card--after">
              <span class="ba__tag ba__tag--after"><Icon name="check" size={13} /> With Bvive</span>
              <p>{sol.outcome}</p>
            </div>
          </div>
          <div class="split__metric">
            <b class="tnum">{sol.metricValue}</b>
            <span>{sol.metricLabel}</span>
          </div>
        </div>
        <div class="split__mock" data-reveal>
          <SolutionMock variant={sol.mock} />
        </div>
      </div>
    </div>
  </section>

  <!-- features -->
  <section class="section section--tint">
    <div class="container">
      <div class="heading-block" data-reveal>
        <span class="eyebrow">What you get</span>
        <h2>Built to move revenue risk into resolved outcomes</h2>
      </div>
      <div class="feats" data-reveal>
        {sol.features.map((f, i) => (
          <article class="feat">
            <span class="feat__n tnum">0{i + 1}</span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ladders up -->
  <section class="section">
    <div class="container">
      <div class="ladder" data-reveal>
        <span class="pill pill--tint"><Icon name={pillar.icon} size={13} /> {pillar.title}</span>
        <h2>Part of one connected platform</h2>
        <p class="lead">This solution works alongside the rest of Bvive, so recovery, retention, operations and reporting share the same customer record.</p>
        <div class="ladder__row">
          {others.map((o) => (
            <a href={`/solutions/${o.slug}`} class="ladder__card">
              <h4>{o.eyebrow}</h4>
              <p>{o.sub}</p>
              <span class="ladder__go"><Icon name="arrow" size={16} /></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <Faq />
  <CTASection />
</Layout>

<style>
  .split__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .ba { margin-top: var(--sp-5); display: grid; gap: var(--sp-3); }
  .ba__card { padding: var(--sp-5); border-radius: var(--r-lg); border: 1px solid var(--border-soft); }
  .ba__card--before { background: var(--white); }
  .ba__card--after { background: linear-gradient(160deg, var(--green-50), var(--blue-50)); border-color: var(--green-100); }
  .ba__tag { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-xs); font-weight: 700; letter-spacing: .03em; text-transform: uppercase; padding: 4px 10px; border-radius: var(--r-pill); margin-bottom: var(--sp-3); }
  .ba__tag--before { background: var(--orange-100); color: var(--orange-600); }
  .ba__tag--after { background: var(--green-500); color: #fff; }
  .ba__card p { color: var(--ink-700); font-size: var(--text-base); }
  .ba__arrow { display: grid; place-items: center; color: var(--ink-300); transform: rotate(90deg); }
  .split__metric { display: flex; align-items: baseline; gap: var(--sp-4); margin-top: var(--sp-6); padding-top: var(--sp-6); border-top: 1px solid var(--border); }
  .split__metric b { font-family: var(--font-display); font-size: var(--text-4xl); color: var(--blue-600); letter-spacing: -.03em; }
  .split__metric span { font-size: var(--text-base); color: var(--text-muted); max-width: 22ch; }

  .feats { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); margin-top: var(--sp-8); }
  .feat { display: flex; gap: var(--sp-4); padding: var(--sp-6); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); }
  .feat__n { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 700; color: var(--blue-200); flex-shrink: 0; }
  .feat h3 { font-size: var(--text-lg); }
  .feat p { margin-top: var(--sp-2); font-size: var(--text-base); color: var(--text-muted); }

  .ladder { text-align: center; max-width: 46rem; margin-inline: auto; }
  .ladder h2 { margin-top: var(--sp-4); }
  .ladder .lead { margin: var(--sp-4) auto var(--sp-8); }
  .ladder__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); text-align: left; }
  .ladder__card { position: relative; padding: var(--sp-6); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .ladder__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .ladder__card h4 { font-size: var(--text-lg); }
  .ladder__card p { margin-top: var(--sp-2); font-size: var(--text-sm); color: var(--text-muted); }
  .ladder__go { position: absolute; top: var(--sp-5); right: var(--sp-5); color: var(--ink-300); }
  .ladder__card:hover .ladder__go { color: var(--blue-600); }

  @media (max-width: 900px) {
    .split__grid, .feats, .ladder__row { grid-template-columns: 1fr; }
  }
</style>
