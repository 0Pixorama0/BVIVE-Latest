---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import CTASection from "../components/CTASection.astro";
const pillars = [
  { ic: "shield", t: "Role-based access", d: "Permissions scope what each person can see and do, so staff only access the accounts and actions relevant to their role." },
  { ic: "eye", t: "Audit-friendly records", d: "Actions and outcomes are logged against each customer, creating a clear trail of who did what and when." },
  { ic: "users", t: "Compliant communication", d: "Bvive supports respectful, consistent follow-up workflows, helping teams communicate earlier and more professionally." },
  { ic: "layers", t: "Sits beside your provider", d: "Bvive is a workflow and visibility layer. It works alongside your existing payment and customer systems." },
];
---
<Layout title="Security & Permissions" description="Bvive uses role-based access and permission controls, and supports compliant communication workflows for sensitive financial follow-up.">
  <PageHero
    eyebrow="Security & permissions"
    title="Built for sensitive financial workflows"
    sub="Recovering payments and managing customer accounts means handling sensitive information. Bvive is designed with access, permissions and careful communication in mind."
    crumb={{ label: "Platform", href: "/platform" }}
    tone="navy"
  >
    <a href="/book-demo" class="btn btn--primary">Book a Demo <Icon name="arrow" size={17} class="btn__icon" /></a>
    <a href="/contact" class="btn btn--on-navy">Talk to us</a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="secgrid" data-reveal>
        {pillars.map((p) => (
          <div class="seccard">
            <span class="seccard__ic"><Icon name={p.ic} size={22} /></span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>

      <div class="secnote" data-reveal>
        <Icon name="shield" size={18} />
        <p><strong>A note on compliance.</strong> Bvive supports compliant communication workflows and careful data handling. It is not a legal or regulatory compliance guarantee. We recommend reviewing your own data, privacy and communication obligations, and we're happy to work with your team and advisors during setup.</p>
      </div>
    </div>
  </section>

  <CTASection eyebrow="Security" title="See how permissions work in practice" body="Book a demo and we'll walk through roles, access and the audit trail on real workflows." />
</Layout>

<style>
  .secgrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-4); }
  .seccard { padding: var(--sp-7); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); }
  .seccard__ic { display: grid; place-items: center; width: 52px; height: 52px; border-radius: 15px; background: linear-gradient(160deg, var(--blue-50), var(--green-50)); color: var(--blue-600); margin-bottom: var(--sp-4); }
  .seccard h3 { font-size: var(--text-xl); }
  .seccard p { margin-top: var(--sp-3); font-size: var(--text-base); color: var(--text-muted); }
  .secnote { display: flex; gap: var(--sp-4); margin-top: var(--sp-6); padding: var(--sp-6); background: var(--ink-50); border: 1px solid var(--border-soft); border-radius: var(--r-lg); }
  .secnote :global(svg) { color: var(--green-600); flex-shrink: 0; margin-top: 2px; }
  .secnote p { font-size: var(--text-base); color: var(--text-muted); }
  @media (max-width: 820px) { .secgrid { grid-template-columns: 1fr; } }
</style>
