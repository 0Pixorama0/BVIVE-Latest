---
/* Reusable app-window chrome shared by all product mockups. */
interface Props { title?: string; class?: string; }
const { title = "app.bvive.com.au", class: cls = "" } = Astro.props;
---
<div class={`appframe ${cls}`}>
  <div class="appframe__bar">
    <span class="appframe__dots"><i></i><i></i><i></i></span>
    <span class="appframe__url">{title}</span>
    <span class="appframe__spacer"></span>
  </div>
  <div class="appframe__body">
    <slot />
  </div>
</div>
<style>
  .appframe {
    background: var(--white);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    outline: 1px solid rgba(11,22,38,.06);
  }
  .appframe__bar {
    display: flex; align-items: center; gap: 12px;
    height: 40px; padding: 0 14px;
    background: linear-gradient(180deg, #f7f9fc, #eef2f8);
    border-bottom: 1px solid var(--border);
  }
  .appframe__dots { display: inline-flex; gap: 6px; }
  .appframe__dots i { width: 10px; height: 10px; border-radius: 50%; background: #d3dae4; }
  .appframe__dots i:nth-child(1) { background: #f5726a; }
  .appframe__dots i:nth-child(2) { background: #f6b73c; }
  .appframe__dots i:nth-child(3) { background: #3fc07a; }
  .appframe__url {
    font-size: 12px; color: var(--ink-400); font-weight: 500;
    background: var(--white); border: 1px solid var(--border);
    padding: 3px 12px; border-radius: var(--r-pill);
    margin-inline: auto; letter-spacing: .01em;
  }
  .appframe__spacer { width: 46px; }
  .appframe__body { background: var(--paper); }
</style>
