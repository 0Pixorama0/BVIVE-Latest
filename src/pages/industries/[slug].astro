---
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/Icon.astro";
import ProductShot from "../../components/ProductShot.astro";
import CTASection from "../../components/CTASection.astro";
import Faq from "../../components/Faq.astro";
import { industries, pillars } from "../../data/site";
import { shots, industryShot } from "../../data/shots";

export function getStaticPaths() {
  return industries.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}
const { ind } = Astro.props;
const others = industries.filter((i) => i.slug !== ind.slug);
---
<Layout title={ind.name} description={ind.sub}>
  <!-- Industry hero: split with image -->
  <section class="ihero">
    <span class="ihero__bg" aria-hidden="true"></span>
    <div class="container ihero__inner">
      <div class="ihero__copy" data-reveal>
        <a href="/industries" class="ihero__crumb"><Icon name="arrow" size={14} class="rot" /> All industries</a>
        <span class="eyebrow">{ind.eyebrow}</span>
        <h1>{ind.title}</h1>
        <p class="ihero__sub">{ind.sub}</p>
        <div class="ihero__cta">
          <a href="/book-demo" class="btn btn--primary btn--lg">Book a Demo <Icon name="arrow" size={18} class="btn__icon" /></a>
          <a href="/calculator" class="btn btn--ghost btn--lg">Estimate your leakage</a>
        </div>
      </div>
      <div class="ihero__media" data-reveal>
        <ProductShot {...shots[industryShot[ind.slug]]} eager />
        <div class="ihero__stat"><b class="tnum">{ind.stat.value}</b><span>{ind.stat.label}</span></div>
      </div>
    </div>
  </section>

  <!-- pain / benefit -->
  <section class="section">
    <div class="container">
      <div class="pb" data-reveal>
        <div class="pb__col">
          <span class="pb__k"><Icon name="bolt" size={15} /> The reality today</span>
          <p>{ind.pain}</p>
        </div>
        <div class="pb__col pb__col--good">
          <span class="pb__k"><Icon name="check-circle" size={15} /> With Bvive</span>
          <p>{ind.benefit}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- points + mock -->
  <section class="section section--tint">
    <div class="container">
      <div class="ipoints" data-reveal>
        <div class="ipoints__copy">
          <span class="eyebrow">One workflow for {ind.short.toLowerCase()}</span>
          <h2>Everything your team needs to protect recurring revenue</h2>
          <ul>
            {ind.points.map((pt) => <li><span class="ipoints__ic"><Icon name="check" size={14} /></span> {pt}</li>)}
          </ul>
          <a href="/platform" class="link-arrow">See the full platform <Icon name="arrow" size={16} /></a>
        </div>
        <div class="ipoints__mock"><ProductShot {...shots.paymentRecovery} /></div>
      </div>
    </div>
  </section>

  <!-- outcomes pillars -->
  <section class="section">
    <div class="container">
      <div class="heading-block" data-reveal><span class="eyebrow">The outcome</span><h2>Four results, whatever you charge for</h2></div>
      <div class="ioutcomes" data-reveal>
        {pillars.map((p) => (
          <div class="iout">
            <span class="iout__ic"><Icon name={p.icon} size={20} /></span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- other industries -->
  <section class="section section--tint">
    <div class="container">
      <div class="heading-block" data-reveal><span class="eyebrow">More industries</span><h2>Bvive fits any recurring-revenue business</h2></div>
      <div class="iother" data-reveal>
        {others.map((o) => (
          <a href={`/industries/${o.slug}`} class="iother__card">
            <b>{o.name}</b>
            <Icon name="arrow-up-right" size={16} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <Faq />
  <CTASection />
</Layout>

<style>
  .ihero { position: relative; overflow: hidden; padding-block: clamp(2.5rem, 5vw, 4rem) clamp(3rem, 6vw, 5rem); background: linear-gradient(180deg, var(--ink-50), var(--paper)); border-bottom: 1px solid var(--border-soft); }
  .ihero__bg { position: absolute; inset: 0; background: radial-gradient(50% 60% at 90% 10%, rgba(0,146,69,.10), transparent 60%); }
  /* the screenshot is landscape, so it needs more width than the old portrait slot */
  .ihero__inner { position: relative; z-index: 2; display: grid; grid-template-columns: 0.92fr 1.08fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  /* flex, not inline-flex, so the eyebrow below starts on its own line */
  .ihero__crumb { display: flex; width: fit-content; align-items: center; gap: 6px; font-size: var(--text-sm); font-weight: 600; color: var(--text-muted); margin-bottom: var(--sp-4); transition: color var(--dur) var(--ease-out), gap var(--dur) var(--ease-out); }
  .ihero__crumb:hover { color: var(--blue-600); gap: 9px; }
  .rot { transform: rotate(180deg); }
  .ihero h1 { margin-top: var(--sp-3); font-size: var(--text-4xl); }
  .ihero__sub { margin-top: var(--sp-5); font-size: var(--text-lg); color: var(--text-muted); }
  .ihero__cta { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-7); }
  .ihero__media { position: relative; }
  /* hangs off the bottom-left corner so it clips the frame rather than
     sitting on top of a chart */
  .ihero__stat { position: absolute; z-index: 2; left: -30px; bottom: -34px; background: var(--white); border: 1px solid var(--border); border-radius: var(--r-lg); padding: var(--sp-3) var(--sp-4); box-shadow: var(--shadow-lg); max-width: 10rem; }
  .ihero__stat b { display: block; font-family: var(--font-display); font-size: var(--text-2xl); color: var(--blue-600); letter-spacing: -.03em; }
  .ihero__stat span { font-size: var(--text-sm); color: var(--text-muted); }

  .pb { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-5); }
  .pb__col { padding: var(--sp-7); border-radius: var(--r-xl); border: 1px solid var(--border-soft); background: var(--white); }
  .pb__col--good { background: linear-gradient(160deg, var(--green-50), var(--blue-50)); border-color: var(--green-100); }
  .pb__k { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-sm); font-weight: 700; letter-spacing: .02em; text-transform: uppercase; color: var(--ink-500); margin-bottom: var(--sp-4); }
  .pb__col--good .pb__k { color: var(--green-600); }
  .pb__col p { font-size: var(--text-lg); color: var(--ink-700); line-height: 1.55; }

  .ipoints { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(2rem, 4vw, 3.5rem); align-items: center; }
  .ipoints__copy h2 { margin: var(--sp-4) 0 var(--sp-5); }
  .ipoints__copy ul { display: grid; gap: var(--sp-3); margin-bottom: var(--sp-6); }
  .ipoints__copy li { display: flex; align-items: center; gap: 11px; font-size: var(--text-lg); color: var(--ink-800); }
  .ipoints__ic { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--green-500); color: #fff; flex-shrink: 0; }

  .ioutcomes { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--sp-4); margin-top: var(--sp-8); }
  .iout { padding: var(--sp-6); border-radius: var(--r-lg); border: 1px solid var(--border-soft); background: var(--white); box-shadow: var(--shadow-xs); }
  .iout__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px; background: var(--ink-50); color: var(--blue-600); margin-bottom: var(--sp-4); }
  .iout h3 { font-size: var(--text-lg); }
  .iout p { margin-top: var(--sp-2); font-size: var(--text-sm); color: var(--text-muted); }

  .iother { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-3); margin-top: var(--sp-7); }
  .iother__card { display: flex; align-items: center; justify-content: space-between; padding: var(--sp-5) var(--sp-6); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .iother__card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .iother__card b { font-family: var(--font-display); font-size: var(--text-lg); font-weight: 500; }
  .iother__card :global(svg) { color: var(--ink-300); }
  .iother__card:hover :global(svg) { color: var(--blue-600); }

  @media (max-width: 900px) {
    .ihero__inner, .pb, .ipoints { grid-template-columns: 1fr; }
    .ioutcomes { grid-template-columns: 1fr 1fr; }
    .iother { grid-template-columns: 1fr; }
  }
  @media (max-width: 540px) { .ioutcomes { grid-template-columns: 1fr; } }
</style>
