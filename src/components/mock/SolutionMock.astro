---
import AppFrame from "./AppFrame.astro";
import Icon from "../Icon.astro";
interface Props { variant: "recovery" | "arrears" | "cancellation" | "crm" | "analytics" | "tasks"; }
const { variant } = Astro.props;
---
<AppFrame class="smock">
  <div class="smock__in">
    {variant === "recovery" && (
      <div class="rv">
        <div class="rv__head"><h4>Recovery queue</h4><span class="chip">Sorted by value</span></div>
        {[
          { n: "Northside Strength Co.", a: "$1,240", s: "Recovered", t: "ok", w: "AM", p: "High" },
          { n: "Metro Dance Academy", a: "$740", s: "Retry sent", t: "info", w: "AM", p: "High" },
          { n: "Little Owls Childcare", a: "$920", s: "In progress", t: "warn", w: "PT", p: "Med" },
          { n: "Coastline Physio", a: "$570", s: "Promised", t: "info", w: "JS", p: "Med" },
          { n: "Peak Pilates Studio", a: "$308", s: "Overdue", t: "bad", w: "Assign", p: "Low" },
        ].map((r) => (
          <div class="rv__row">
            <span class={`pri pri--${r.p.toLowerCase()}`}>{r.p}</span>
            <span class="rv__id"><b>{r.n}</b></span>
            <span class="rv__amt tnum">{r.a}</span>
            <span class="rv__w">{r.w}</span>
            <span class={`tg tg--${r.t}`}>{r.s}</span>
          </div>
        ))}
      </div>
    )}

    {variant === "arrears" && (
      <div class="ar">
        <div class="ar__head"><h4>Arrears ledger</h4><span class="chip">142 accounts · $12,480</span></div>
        <div class="ar__cols"><span>Account</span><span>Balance</span><span>Age</span><span>Status</span></div>
        {[
          { n: "Peak Pilates Studio", b: "$308", g: "3 days", s: "New", t: "info" },
          { n: "Riverside Swim School", b: "$465", g: "9 days", s: "Contacted", t: "warn" },
          { n: "Elite Martial Arts", b: "$1,120", g: "16 days", s: "Promised", t: "info" },
          { n: "Bright Beginnings CC", b: "$680", g: "24 days", s: "Escalated", t: "bad" },
        ].map((r) => (
          <div class="ar__row">
            <span class="ar__n"><b>{r.n}</b></span>
            <span class="tnum">{r.b}</span>
            <span class="ar__g tnum">{r.g}</span>
            <span class={`tg tg--${r.t}`}>{r.s}</span>
          </div>
        ))}
      </div>
    )}

    {variant === "cancellation" && (
      <div class="kb">
        <div class="kb__head"><h4>Cancellation saves</h4><span class="chip">63% save rate</span></div>
        <div class="kb__cols">
          {[
            { t: "Requested", n: 8, tone: "info", items: ["Price concern", "Moving away"] },
            { t: "Saving", n: 5, tone: "warn", items: ["Pause offer sent", "Callback booked"] },
            { t: "Saved", n: 12, tone: "ok", items: ["Downgraded plan", "Freeze 1 month"] },
          ].map((c) => (
            <div class="kb__col">
              <div class="kb__colhead"><span class={`dotk dotk--${c.tone}`}></span> {c.t} <b>{c.n}</b></div>
              {c.items.map((i) => <div class="kb__card">{i}</div>)}
            </div>
          ))}
        </div>
      </div>
    )}

    {variant === "crm" && (
      <div class="cr">
        <div class="cr__top">
          <span class="cr__av">NS</span>
          <div><b>Northside Strength Co.</b><em>Member since 2023 · $58/wk · Gyms</em></div>
          <span class="tg tg--ok">Active</span>
        </div>
        <div class="cr__risk"><span>Payment risk</span><div class="cr__bar"><i style="width:22%"></i></div><b>Low</b></div>
        <div class="cr__tl">
          {[
            { i: "recover", t: "Failed debit recovered", d: "$1,240 · 2 days" },
            { i: "tasks", t: "Follow-up completed by AM", d: "Called member · 4 days" },
            { i: "retain", t: "Cancellation saved", d: "Offered pause · 3 wks" },
            { i: "crm", t: "Note added", d: "Prefers SMS contact · 1 mo" },
          ].map((e) => (
            <div class="cr__ev"><span class="cr__ic"><Icon name={e.i} size={14} /></span><div><b>{e.t}</b><em>{e.d}</em></div></div>
          ))}
        </div>
      </div>
    )}

    {variant === "analytics" && (
      <div class="an">
        <div class="an__head"><h4>Revenue recovery report</h4><span class="chip">Last 6 months</span></div>
        <div class="an__stats">
          <div><span>Recovered</span><b class="tnum">$284k</b></div>
          <div><span>Save rate</span><b class="tnum">63%</b></div>
          <div><span>Avg. days</span><b class="tnum">3.4</b></div>
        </div>
        <div class="an__chart">
          {[52, 61, 58, 72, 80, 96].map((h, i) => (
            <div class="an__bar"><i style={`height:${h}%`}></i><span>{["Feb","Mar","Apr","May","Jun","Jul"][i]}</span></div>
          ))}
        </div>
      </div>
    )}

    {variant === "tasks" && (
      <div class="tk">
        <div class="tk__head"><h4>My tasks</h4><span class="chip">Today · 6 open</span></div>
        {[
          { t: "Call Peak Pilates re: overdue $308", w: "AM", due: "Today", done: false },
          { t: "Send retry link — Metro Dance", w: "AM", due: "Today", done: false },
          { t: "Follow up cancellation — Coastline", w: "JS", due: "Tomorrow", done: false },
          { t: "Confirm payment arrangement — Elite", w: "PT", due: "Done", done: true },
        ].map((r) => (
          <div class={`tk__row ${r.done ? "is-done" : ""}`}>
            <span class="tk__box">{r.done ? "✓" : ""}</span>
            <span class="tk__t">{r.t}</span>
            <span class="tk__w">{r.w}</span>
            <span class={`tk__due ${r.done ? "ok" : ""}`}>{r.due}</span>
          </div>
        ))}
      </div>
    )}
  </div>
</AppFrame>

<style>
  .smock__in { padding: 18px; min-height: 340px; font-size: 13px; }
  .smock__in h4 { font-family: var(--font-sans); font-size: 14px; font-weight: 600; }
  .chip { font-size: 11px; color: var(--ink-400); background: var(--ink-50); padding: 4px 10px; border-radius: var(--r-pill); }
  .tg { font-size: 10.5px; font-weight: 600; padding: 3px 8px; border-radius: var(--r-pill); white-space: nowrap; }
  .tg--ok { background: var(--green-100); color: var(--green-600); } .tg--info { background: var(--blue-50); color: var(--blue-700); }
  .tg--warn { background: var(--amber-100); color: var(--amber-600); } .tg--bad { background: var(--red-100); color: var(--red-600); }

  /* recovery */
  .rv__head, .ar__head, .kb__head, .an__head, .tk__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px; }
  .rv__row { display: grid; grid-template-columns: auto 1fr auto 30px auto; align-items: center; gap: 10px; padding: 10px; border-radius: 10px; }
  .rv__row:nth-child(even) { background: var(--ink-50); }
  .rv__id b { font-size: 12.5px; color: var(--ink-800); font-weight: 600; }
  .rv__amt { font-weight: 700; color: var(--ink-900); }
  .rv__w { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--blue-50); color: var(--blue-700); font-size: 9.5px; font-weight: 700; }
  .pri { font-size: 10px; font-weight: 700; padding: 2px 7px; border-radius: 5px; text-transform: uppercase; letter-spacing: .04em; }
  .pri--high { background: #fde7e7; color: var(--red-600); } .pri--med { background: var(--amber-100); color: var(--amber-600); } .pri--low { background: var(--ink-100); color: var(--ink-500); }

  /* arrears */
  .ar__cols, .ar__row { display: grid; grid-template-columns: 1.6fr .8fr .8fr 1fr; gap: 10px; align-items: center; }
  .ar__cols { font-size: 10.5px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-400); padding: 0 10px 8px; border-bottom: 1px solid var(--border-soft); }
  .ar__row { padding: 11px 10px; border-bottom: 1px solid var(--border-soft); }
  .ar__n b { font-weight: 600; color: var(--ink-800); font-size: 12.5px; }
  .ar__g { color: var(--ink-500); }

  /* kanban */
  .kb__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .kb__col { background: var(--ink-50); border-radius: var(--r-md); padding: 10px; }
  .kb__colhead { display: flex; align-items: center; gap: 7px; font-size: 12px; font-weight: 600; color: var(--ink-700); margin-bottom: 10px; }
  .kb__colhead b { margin-left: auto; color: var(--ink-400); }
  .dotk { width: 7px; height: 7px; border-radius: 50%; } .dotk--info { background: var(--blue-500); } .dotk--warn { background: var(--amber-500); } .dotk--ok { background: var(--green-500); }
  .kb__card { background: var(--white); border: 1px solid var(--border-soft); border-radius: 9px; padding: 10px; font-size: 11.5px; color: var(--ink-700); margin-bottom: 7px; box-shadow: var(--shadow-xs); }

  /* crm */
  .cr__top { display: flex; align-items: center; gap: 12px; padding-bottom: 14px; border-bottom: 1px solid var(--border-soft); }
  .cr__av { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: var(--grad-brand); color: #fff; font-size: 13px; font-weight: 700; }
  .cr__top b { font-size: 13.5px; } .cr__top em { font-style: normal; display: block; font-size: 11.5px; color: var(--ink-400); }
  .cr__top .tg { margin-left: auto; }
  .cr__risk { display: flex; align-items: center; gap: 10px; padding: 14px 0; font-size: 12px; color: var(--ink-500); }
  .cr__bar { flex: 1; height: 7px; background: var(--ink-100); border-radius: 999px; overflow: hidden; }
  .cr__bar i { display: block; height: 100%; background: var(--green-500); }
  .cr__risk b { color: var(--green-600); }
  .cr__tl { display: grid; gap: 4px; }
  .cr__ev { display: flex; gap: 11px; padding: 9px; border-radius: 9px; }
  .cr__ev:hover { background: var(--ink-50); }
  .cr__ic { flex-shrink: 0; display: grid; place-items: center; width: 26px; height: 26px; border-radius: 8px; background: var(--blue-50); color: var(--blue-600); }
  .cr__ev b { font-size: 12.5px; color: var(--ink-800); } .cr__ev em { font-style: normal; display: block; font-size: 11px; color: var(--ink-400); }

  /* analytics */
  .an__stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; margin-bottom: 16px; }
  .an__stats div { background: var(--ink-50); border-radius: var(--r-md); padding: 12px; }
  .an__stats span { font-size: 11px; color: var(--ink-500); } .an__stats b { display: block; font-family: var(--font-display); font-size: 20px; letter-spacing: -.02em; margin-top: 3px; }
  .an__chart { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px; align-items: end; height: 130px; padding-top: 10px; }
  .an__bar { display: flex; flex-direction: column; align-items: center; gap: 8px; height: 100%; justify-content: flex-end; }
  .an__bar i { width: 100%; max-width: 34px; border-radius: 6px 6px 0 0; background: var(--grad-brand); }
  .an__bar:last-child i { background: linear-gradient(180deg, #10b5a6, #17b26a); }
  .an__bar span { font-size: 10.5px; color: var(--ink-400); }

  /* tasks */
  .tk__row { display: grid; grid-template-columns: auto 1fr auto auto; align-items: center; gap: 12px; padding: 12px 8px; border-bottom: 1px solid var(--border-soft); }
  .tk__box { width: 19px; height: 19px; border-radius: 6px; border: 1.5px solid var(--ink-300); display: grid; place-items: center; font-size: 12px; color: #fff; }
  .tk__row.is-done .tk__box { background: var(--green-500); border-color: var(--green-500); }
  .tk__row.is-done .tk__t { text-decoration: line-through; color: var(--ink-400); }
  .tk__t { font-size: 12.5px; color: var(--ink-700); }
  .tk__w { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 50%; background: var(--blue-50); color: var(--blue-700); font-size: 9.5px; font-weight: 700; }
  .tk__due { font-size: 11px; font-weight: 600; color: var(--ink-500); background: var(--ink-50); padding: 3px 9px; border-radius: var(--r-pill); }
  .tk__due.ok { color: var(--green-600); background: var(--green-100); }
</style>
