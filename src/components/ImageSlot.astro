---
import Icon from "./Icon.astro";
interface Props {
  label: string;            // what image belongs here (shown until src supplied)
  src?: string;             // drop a real image path here to replace the placeholder
  alt?: string;
  ratio?: string;           // e.g. "16 / 10"
  kind?: "photo" | "ui";
  rounded?: string;         // css radius var
  class?: string;
  eager?: boolean;
}
const {
  label, src, alt = label, ratio = "16 / 10",
  kind = "photo", rounded = "var(--r-xl)", class: cls = "", eager = false,
} = Astro.props;
---
{src ? (
  <img
    src={src} alt={alt} class={`imgslot__img ${cls}`}
    style={`aspect-ratio:${ratio};border-radius:${rounded}`}
    loading={eager ? "eager" : "lazy"} decoding="async"
  />
) : (
  <figure
    class={`imgslot imgslot--${kind} ${cls}`}
    style={`aspect-ratio:${ratio};border-radius:${rounded}`}
    data-image-needed={label}
    role="img" aria-label={`Image placeholder: ${label}`}
  >
    <span class="imgslot__glow" aria-hidden="true"></span>
    <span class="imgslot__grid" aria-hidden="true"></span>
    <span class="imgslot__badge">
      <Icon name={kind === "ui" ? "grid" : "eye"} size={15} />
      Image
    </span>
    <figcaption class="imgslot__label">{label}</figcaption>
  </figure>
)}
<style>
  .imgslot__img { width: 100%; object-fit: cover; box-shadow: var(--shadow-lg); }
  .imgslot {
    position: relative; width: 100%; overflow: hidden;
    display: flex; align-items: flex-end;
    background:
      radial-gradient(120% 120% at 15% 0%, rgba(0,113,188,.14), transparent 55%),
      radial-gradient(120% 120% at 100% 100%, rgba(0,146,69,.16), transparent 55%),
      linear-gradient(160deg, #eef3fb 0%, #e7edf6 100%);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-md);
  }
  .imgslot--ui {
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(0,146,69,.18), transparent 55%),
      radial-gradient(120% 120% at 0% 100%, rgba(0,113,188,.22), transparent 55%),
      linear-gradient(160deg, #0d2440 0%, #061c2e 100%);
    border-color: var(--navy-line);
  }
  .imgslot__glow {
    position: absolute; inset: 0;
    background: var(--grad-glow); opacity: .8;
    mix-blend-mode: screen;
  }
  .imgslot__grid {
    position: absolute; inset: 0; opacity: .5;
    background-image:
      linear-gradient(to right, rgba(10,23,37,.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(10,23,37,.05) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent);
            mask-image: radial-gradient(80% 80% at 50% 40%, #000, transparent);
  }
  .imgslot--ui .imgslot__grid {
    background-image:
      linear-gradient(to right, rgba(255,255,255,.06) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.06) 1px, transparent 1px);
  }
  .imgslot__badge {
    position: absolute; top: 14px; left: 14px;
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 10px; border-radius: var(--r-pill);
    font-size: var(--text-xs); font-weight: 600; letter-spacing: .02em;
    background: rgba(255,255,255,.72); color: var(--ink-600);
    border: 1px solid rgba(255,255,255,.5); backdrop-filter: blur(6px);
  }
  .imgslot--ui .imgslot__badge { background: rgba(9,24,44,.5); color: #bcd; border-color: rgba(255,255,255,.14); }
  .imgslot__label {
    position: relative; z-index: 2;
    margin: var(--sp-5); max-width: 32ch;
    font-size: var(--text-sm); font-weight: 500; line-height: 1.45;
    color: var(--ink-600);
  }
  .imgslot--ui .imgslot__label { color: #a9bad0; }
</style>
