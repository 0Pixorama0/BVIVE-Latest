---
import Icon from "./Icon.astro";
interface Props {
  eyebrow?: string;
  title?: string;
  body?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}
const {
  eyebrow = "Get started",
  title = "See how much revenue your business could be recovering",
  body = "Book a guided demo and we'll show you where Bvive can protect payments, customers and cash flow — mapped to your industry and customer volume.",
  primary = { label: "Book a Demo", href: "/book-demo" },
  secondary = { label: "Estimate your leakage", href: "/calculator" },
} = Astro.props;
---
<section class="ctaband">
  <div class="container">
    <div class="ctaband__card" data-reveal>
      <span class="ctaband__glow" aria-hidden="true"></span>
      <span class="ctaband__grid" aria-hidden="true"></span>
      <div class="ctaband__content">
        <span class="eyebrow eyebrow--center">{eyebrow}</span>
        <h2>{title}</h2>
        <p>{body}</p>
        <div class="ctaband__actions">
          <a href={primary.href} class="btn btn--primary btn--lg">{primary.label} <Icon name="arrow" size={18} class="btn__icon" /></a>
          <a href={secondary.href} class="btn btn--on-navy btn--lg">{secondary.label}</a>
        </div>
        <p class="ctaband__fine">No obligation · Built for businesses with 500+ recurring customers</p>
      </div>
    </div>
  </div>
</section>
<style>
  .ctaband { padding-block: var(--section-y); }
  .ctaband__card {
    position: relative; overflow: hidden;
    border-radius: var(--r-2xl);
    background: radial-gradient(120% 140% at 50% -20%, #0e3358 0%, #071a2e 55%, #050e1c 100%);
    padding: clamp(2.5rem, 6vw, 5.5rem) var(--gutter);
    text-align: center;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--navy-line);
  }
  .ctaband__glow { position: absolute; inset: 0; background: var(--grad-glow); opacity: .9; }
  .ctaband__grid {
    position: absolute; inset: 0; opacity: .4;
    background-image:
      linear-gradient(to right, rgba(255,255,255,.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,.05) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(70% 70% at 50% 0%, #000, transparent);
            mask-image: radial-gradient(70% 70% at 50% 0%, #000, transparent);
  }
  .ctaband__content { position: relative; z-index: 2; max-width: 44rem; margin-inline: auto; }
  .ctaband__content h2 { color: #fff; margin-top: var(--sp-4); font-size: var(--text-4xl); }
  .ctaband__content p { color: #9fb4cb; margin-top: var(--sp-4); font-size: var(--text-lg); }
  .ctaband__actions { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; margin-top: var(--sp-7); }
  .ctaband__fine { margin-top: var(--sp-5); font-size: var(--text-sm); color: #6f849c; }
</style>
