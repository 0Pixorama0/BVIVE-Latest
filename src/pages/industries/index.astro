---
import Layout from "../../layouts/Layout.astro";
import PageHero from "../../components/PageHero.astro";
import Icon from "../../components/Icon.astro";
import ProductShot from "../../components/ProductShot.astro";
import CTASection from "../../components/CTASection.astro";
import { industries, moreIndustries } from "../../data/site";
import { shots, industryShot } from "../../data/shots";
---
<Layout title="Industries" description="Bvive supports gyms, childcare, allied health, education, subscription and other recurring-revenue businesses across Australia.">
  <PageHero
    eyebrow="Industries"
    title="Built for businesses with recurring customers and direct-debit revenue"
    sub="If your business depends on regular payments, small operational gaps become a real profit leak. Bvive fits the way each industry actually operates."
    crumb={{ label: "Home", href: "/" }}
  >
    <a href="/book-demo" class="btn btn--primary">Book a Demo <Icon name="arrow" size={17} class="btn__icon" /></a>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="igrid">
        {industries.map((ind, i) => (
          <a href={`/industries/${ind.slug}`} class={`icard ${i === 0 ? "icard--feature" : ""}`} data-reveal>
            <div class="icard__media">
              <ProductShot {...shots[industryShot[ind.slug]]} glow={false} ratio={i === 0 ? "16 / 9" : "16 / 11"} />
            </div>
            <div class="icard__body">
              <div class="icard__stat"><b class="tnum">{ind.stat.value}</b> <span>{ind.stat.label}</span></div>
              <h3>{ind.name}</h3>
              <p>{ind.sub}</p>
              <span class="icard__link">Explore {ind.short} <Icon name="arrow" size={14} /></span>
            </div>
          </a>
        ))}
      </div>

      <div class="imore" data-reveal>
        <h4>Also supporting</h4>
        <ul>
          {moreIndustries.map((m) => <li><Icon name="check" size={14} /> {m}</li>)}
        </ul>
        <p>Any business with 500+ recurring or direct-debit customers can protect revenue with Bvive. <a href="/contact" class="link-arrow">Tell us about yours <Icon name="arrow" size={14} /></a></p>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

<style>
  .igrid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-5); }
  .icard { display: flex; flex-direction: column; overflow: hidden; background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-xl); box-shadow: var(--shadow-xs); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out); }
  .icard:hover { transform: translateY(-5px); box-shadow: var(--shadow-lg); }
  .icard--feature { grid-column: span 2; flex-direction: row; }
  .icard--feature .icard__media { flex: 1.1; }
  .icard--feature .icard__body { flex: 1; display: flex; flex-direction: column; justify-content: center; }
  .icard__media { overflow: hidden; }
  .icard__media :global(.imgslot), .icard__media :global(.imgslot__img) { border-radius: 0 !important; border-left: 0; border-right: 0; border-top: 0; }
  .icard__body { padding: var(--sp-6); }
  .icard__stat { font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--sp-3); }
  .icard__stat b { font-family: var(--font-display); color: var(--blue-600); font-size: var(--text-lg); }
  .icard h3 { font-size: var(--text-xl); }
  .icard--feature h3 { font-size: var(--text-2xl); }
  .icard p { margin-top: var(--sp-3); font-size: var(--text-base); color: var(--text-muted); }
  .icard__link { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--sp-5); font-size: var(--text-sm); font-weight: 600; color: var(--blue-600); }

  .imore { margin-top: var(--sp-8); padding: var(--sp-7); background: var(--ink-50); border: 1px solid var(--border-soft); border-radius: var(--r-xl); }
  .imore h4 { font-size: var(--text-sm); text-transform: uppercase; letter-spacing: .08em; color: var(--ink-500); }
  .imore ul { display: flex; flex-wrap: wrap; gap: var(--sp-3) var(--sp-6); margin: var(--sp-4) 0 var(--sp-5); }
  .imore li { display: inline-flex; align-items: center; gap: 8px; font-size: var(--text-base); font-weight: 500; color: var(--ink-700); }
  .imore li :global(svg) { color: var(--green-600); }
  .imore p { color: var(--text-muted); }

  @media (max-width: 820px) {
    .igrid { grid-template-columns: 1fr; }
    .icard--feature { grid-column: span 1; flex-direction: column; }
  }
</style>
