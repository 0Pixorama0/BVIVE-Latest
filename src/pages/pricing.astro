---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Faq from "../components/Faq.astro";
import CTASection from "../components/CTASection.astro";

const plans = [
  {
    name: "Growth", for: "500 – 2,500 recurring customers",
    blurb: "For single-site operators ready to move off spreadsheets and recover more.",
    features: ["Payment recovery workflow", "Arrears management", "Customer lifecycle CRM", "Staff tasks & accountability", "Core analytics", "Guided onboarding"],
    featured: false,
  },
  {
    name: "Scale", for: "2,500 – 10,000 recurring customers",
    blurb: "For multi-site and growing businesses that need visibility across teams.",
    features: ["Everything in Growth", "Cancellation management", "Advanced analytics & reporting", "Role-based permissions", "Multi-location views", "Priority onboarding support"],
    featured: true,
  },
  {
    name: "Enterprise", for: "10,000+ recurring customers",
    blurb: "For franchises and networks with complex structures and reporting needs.",
    features: ["Everything in Scale", "Custom roles & workflows", "Consolidated group reporting", "Dedicated implementation", "Roadmap access (AI, commission)", "Partner & integration support"],
    featured: false,
  },
];
const anchors = [
  { ic: "dollar", t: "Recovered revenue", d: "Priced against the revenue you protect, not per seat, so your team can all get involved." },
  { ic: "clock", t: "Admin hours saved", d: "Automating follow-up removes hours of manual chasing every week." },
  { ic: "gauge", t: "Best-fit setup", d: "We assess your volume, process and provider to recommend the right configuration." },
];
---
<Layout title="Pricing" description="Pricing built around your customer volume and recovery needs. Book a demo to assess your recurring-revenue risk and best-fit Bvive setup.">
  <PageHero
    eyebrow="Pricing"
    title="Pricing built around your customer volume and recovery needs"
    sub="Bvive is priced to your recurring-revenue scale, not a per-seat count. Book a demo and we'll assess your risk, current process and best-fit setup."
    crumb={{ label: "Home", href: "/" }}
    align="center"
  />

  <section class="section section--flush-top pricing">
    <div class="container">
      <div class="plans" data-reveal>
        {plans.map((p) => (
          <article class={`plan ${p.featured ? "plan--featured" : ""}`}>
            {p.featured && <span class="plan__badge">Most popular</span>}
            <h3>{p.name}</h3>
            <p class="plan__for">{p.for}</p>
            <p class="plan__blurb">{p.blurb}</p>
            <div class="plan__price"><span class="plan__amt">Custom</span><span class="plan__per">demo-based pricing</span></div>
            <a href="/book-demo" class={`btn ${p.featured ? "btn--primary" : "btn--ghost"} btn--block`}>Book a Demo</a>
            <ul class="plan__list">
              {p.features.map((f) => <li><Icon name="check" size={15} /> {f}</li>)}
            </ul>
          </article>
        ))}
      </div>

      <div class="anchor" data-reveal>
        <div class="anchor__head"><span class="eyebrow">How we price</span><h2>Anchored to the value you get back</h2></div>
        <div class="anchor__row">
          {anchors.map((a) => (
            <div class="anchor__card">
              <span class="anchor__ic"><Icon name={a.ic} size={20} /></span>
              <b>{a.t}</b>
              <p>{a.d}</p>
            </div>
          ))}
        </div>
        <a href="/calculator" class="link-arrow anchor__link">Estimate your revenue leakage first <Icon name="arrow" size={16} /></a>
      </div>
    </div>
  </section>

  <Faq />
  <CTASection eyebrow="Pricing" title="Let's find the right setup for your business" body="Book a demo and we'll size your recovery opportunity and recommend the best-fit Bvive configuration for your customer volume." />
</Layout>

<style>
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); align-items: start; }
  .plan { position: relative; padding: clamp(1.75rem, 3vw, 2.5rem); background: var(--white); border: 1px solid var(--border); border-radius: var(--r-xl); box-shadow: var(--shadow-sm); }
  .plan--featured { border-color: transparent; box-shadow: var(--shadow-xl); background: radial-gradient(130% 120% at 50% -10%, #0e3358, #061c2e 70%); color: #cdd8e6; transform: translateY(-8px); }
  .plan__badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--grad-brand); color: #fff; font-size: var(--text-xs); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 6px 14px; border-radius: var(--r-pill); box-shadow: var(--shadow-brand); }
  .plan h3 { font-size: var(--text-2xl); }
  .plan--featured h3 { color: #fff; }
  .plan__for { margin-top: 4px; font-size: var(--text-sm); font-weight: 600; color: var(--blue-600); }
  .plan--featured .plan__for { color: var(--green-400); }
  .plan__blurb { margin-top: var(--sp-4); font-size: var(--text-base); color: var(--text-muted); min-height: 3em; }
  .plan--featured .plan__blurb { color: #9fb4cb; }
  .plan__price { display: flex; align-items: baseline; gap: 8px; margin: var(--sp-5) 0; padding-bottom: var(--sp-5); border-bottom: 1px solid var(--border); }
  .plan--featured .plan__price { border-color: var(--navy-line); }
  .plan__amt { font-family: var(--font-display); font-size: var(--text-3xl); font-weight: 600; letter-spacing: -.03em; color: var(--ink-900); }
  .plan--featured .plan__amt { color: #fff; }
  .plan__per { font-size: var(--text-sm); color: var(--text-muted); }
  .plan__list { margin-top: var(--sp-6); display: grid; gap: var(--sp-3); }
  .plan__list li { display: flex; align-items: flex-start; gap: 10px; font-size: var(--text-base); color: var(--ink-700); }
  .plan--featured .plan__list li { color: #b6c7da; }
  .plan__list :global(svg) { color: var(--green-600); flex-shrink: 0; margin-top: 3px; }
  .plan--featured .plan__list :global(svg) { color: var(--green-400); }

  .anchor { margin-top: var(--sp-11); text-align: center; }
  .anchor__head { max-width: 40rem; margin: 0 auto var(--sp-7); }
  .anchor__head h2 { margin-top: var(--sp-3); }
  .anchor__row { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); text-align: left; }
  .anchor__card { padding: var(--sp-6); background: var(--ink-50); border: 1px solid var(--border-soft); border-radius: var(--r-lg); }
  .anchor__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px; background: var(--white); color: var(--blue-600); box-shadow: var(--shadow-xs); margin-bottom: var(--sp-4); }
  .anchor__card b { font-family: var(--font-display); font-size: var(--text-lg); }
  .anchor__card p { margin-top: var(--sp-2); font-size: var(--text-base); color: var(--text-muted); }
  .anchor__link { margin-top: var(--sp-7); }

  @media (max-width: 900px) {
    .plans, .anchor__row { grid-template-columns: 1fr; }
    .plan--featured { transform: none; }
  }
</style>
