---
import { Image } from "astro:assets";
import logoDark from "../assets/bvive-logo.png";
import logoLight from "../assets/bvive-logo-white.png";
import markDark from "../assets/bvive-mark.png";
import markLight from "../assets/bvive-mark-white.png";

interface Props {
  variant?: "dark" | "light";
  class?: string;
  showWord?: boolean;
  height?: number;
  href?: string | null;
}
const {
  variant = "dark",
  class: cls = "",
  showWord = true,
  height = 30,
  href = "/",
} = Astro.props;

const src = showWord
  ? variant === "light" ? logoLight : logoDark
  : variant === "light" ? markLight : markDark;

const ratio = src.width / src.height;
const width = Math.round(height * ratio);
---
{href ? (
  <a href={href} aria-label="Bvive, home" class:list={["logo", cls]} data-on={variant} style={`--logo-h:${height}px`}>
    <span class="logo__aura" aria-hidden="true"></span>
    <Image src={src} alt="" width={width * 2} height={height * 2} loading="eager" class="logo__img" />
  </a>
) : (
  <span class:list={["logo", cls]} data-on={variant} style={`--logo-h:${height}px`}>
    <span class="logo__aura" aria-hidden="true"></span>
    <Image src={src} alt="Bvive" width={width * 2} height={height * 2} loading="eager" class="logo__img" />
  </span>
)}

<style>
  .logo {
    position: relative;
    display: inline-flex;
    align-items: center;
    isolation: isolate;
    transition: transform var(--dur) var(--ease-spring);
  }
  /* :global because <Image> renders the <img>, so Astro's scope hash
     is not applied to it. */
  .logo :global(.logo__img) {
    position: relative;
    z-index: 1;
    height: var(--logo-h);
    width: auto;
    transition: filter var(--dur-slow) var(--ease-out);
  }

  /* Four-colour aura pulled from the mark's own glyphs. Anchored over the
     icon so the wordmark stays clean. */
  .logo__aura {
    position: absolute;
    z-index: 0;
    top: 50%;
    left: calc(var(--logo-h) * 0.5);
    width: calc(var(--logo-h) * 2.2);
    height: calc(var(--logo-h) * 2.2);
    translate: -50% -50%;
    border-radius: 50%;
    pointer-events: none;
    opacity: .12;
    scale: .82;
    background:
      radial-gradient(circle at 50% 22%, rgb(var(--rgb-amber) / .5), transparent 48%),
      radial-gradient(circle at 22% 50%, rgb(var(--rgb-blue) / .5), transparent 48%),
      radial-gradient(circle at 78% 50%, rgb(var(--rgb-green) / .5), transparent 48%),
      radial-gradient(circle at 50% 78%, rgb(var(--rgb-orange) / .5), transparent 48%);
    filter: blur(calc(var(--logo-h) * 0.36));
    transition: opacity var(--dur-slow) var(--ease-out), scale var(--dur-slow) var(--ease-out);
  }
  /* On navy the aura has to add light, otherwise the four colours composite
     into a muddy patch behind the mark. */
  .logo[data-on="light"] .logo__aura { mix-blend-mode: screen; opacity: .3; }

  /* Idle: a slow, barely-there breath so the mark feels alive. */
  @media (prefers-reduced-motion: no-preference) {
    .logo__aura { animation: logo-breathe 6s var(--ease-in-out) infinite; }
    @keyframes logo-breathe {
      0%, 100% { opacity: .10; scale: .82; }
      50%      { opacity: .26; scale: .95; }
    }
    .logo[data-on="light"] .logo__aura { animation-name: logo-breathe-dark; }
    @keyframes logo-breathe-dark {
      0%, 100% { opacity: .26; scale: .82; }
      50%      { opacity: .5;  scale: .95; }
    }
  }

  .logo:hover { transform: translateY(-1px); }
  .logo:hover .logo__aura,
  .logo:focus-visible .logo__aura { opacity: .72; scale: 1.06; animation-play-state: paused; }
  .logo:hover :global(.logo__img) { filter: saturate(1.12); }
  .logo:active { transform: translateY(0) scale(.985); }
  .logo:focus-visible { outline: none; }

  @media (prefers-reduced-motion: reduce) {
    .logo, .logo__aura { transition: none; }
    .logo :global(.logo__img) { transition: none; }
  }
</style>
