---
import Icon from "./Icon.astro";
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
  crumb?: { label: string; href: string };
  align?: "left" | "center";
  tone?: "light" | "navy";
}
const { eyebrow, title, sub, crumb, align = "left", tone = "light" } = Astro.props;
---
<section class={`phero phero--${tone} phero--${align}`}>
  {tone === "navy" && <span class="phero__bg" aria-hidden="true"></span>}
  {tone === "navy" && <span class="phero__grid" aria-hidden="true"></span>}
  <div class="container phero__inner">
    {crumb && (
      <a href={crumb.href} class="phero__crumb"><Icon name="arrow" size={14} class="phero__crumb-ic" /> {crumb.label}</a>
    )}
    <span class={`eyebrow ${align === "center" ? "eyebrow--center" : ""}`}>{eyebrow}</span>
    <h1>{title}</h1>
    {sub && <p class="phero__sub">{sub}</p>}
    {Astro.slots.has("default") && <div class="phero__actions"><slot /></div>}
  </div>
</section>
<style>
  .phero { position: relative; overflow: hidden; padding-block: clamp(3rem, 6vw, 5.5rem) clamp(2.5rem, 5vw, 4rem); }
  .phero--light { background: linear-gradient(180deg, var(--ink-50), var(--paper)); border-bottom: 1px solid var(--border-soft); }
  .phero--navy { background: var(--navy-900); color: #cdd8e6; }
  .phero__bg { position: absolute; inset: 0; background: radial-gradient(70% 60% at 80% -10%, rgba(16,181,166,.16), transparent 55%), radial-gradient(60% 60% at 10% 0%, rgba(31,99,232,.20), transparent 55%); }
  .phero__grid { position: absolute; inset: 0; opacity: .4; background-image: linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 44px 44px; -webkit-mask-image: radial-gradient(80% 70% at 50% 0%, #000, transparent); mask-image: radial-gradient(80% 70% at 50% 0%, #000, transparent); }
  .phero__inner { position: relative; z-index: 2; max-width: 52rem; }
  .phero--center .phero__inner { margin-inline: auto; text-align: center; }
  .phero__crumb { display: inline-flex; align-items: center; gap: 6px; font-size: var(--text-sm); font-weight: 600; color: var(--text-muted); margin-bottom: var(--sp-4); }
  .phero__crumb-ic { transform: rotate(180deg); }
  .phero--navy .phero__crumb { color: #8fa6bf; }
  .phero h1 { margin-top: var(--sp-3); font-size: var(--text-4xl); }
  .phero--navy h1 { color: #fff; }
  .phero__sub { margin-top: var(--sp-5); font-size: var(--text-lg); color: var(--text-muted); max-width: 46rem; }
  .phero--center .phero__sub { margin-inline: auto; }
  .phero--navy .phero__sub { color: #9fb4cb; }
  .phero__actions { display: flex; gap: var(--sp-3); flex-wrap: wrap; margin-top: var(--sp-7); }
  .phero--center .phero__actions { justify-content: center; }
</style>
