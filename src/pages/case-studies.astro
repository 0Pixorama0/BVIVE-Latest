---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import ProductShot from "../components/ProductShot.astro";
import CTASection from "../components/CTASection.astro";
import { shots } from "../data/shots";

const scenarios = [
  {
    industry: "Gyms & Fitness", shot: "paymentRecovery" as const,
    metric: "$4,100", metricLabel: "modelled monthly recovery",
    before: "Failed member debits were exported weekly and chased inconsistently by whoever had time.",
    after: "Every failed payment becomes a prioritised, owned task with a logged outcome and a clear recovery figure.",
  },
  {
    industry: "Childcare", shot: "taskBoard" as const,
    metric: "63%", metricLabel: "modelled cancellation save rate",
    before: "Overdue family accounts lived in a spreadsheet and cancellation requests slipped through.",
    after: "A single arrears view and a structured save workflow keep every account moving toward resolution.",
  },
  {
    industry: "Allied Health", shot: "arrearsManagement" as const,
    metric: "3.4 days", metricLabel: "modelled avg. time to recover",
    before: "Recurring care payments failed quietly and follow-up depended on memory.",
    after: "Risk surfaces the moment it appears, so the team acts earlier and care revenue stays on track.",
  },
];
const proof = [
  { ic: "grid", t: "Process proof", d: "See the real recovery, arrears and cancellation workflows in a live demo, not just slides." },
  { ic: "gauge", t: "Your numbers modelled", d: "We size the recovery opportunity against your actual volume and average debit." },
  { ic: "shield", t: "Handled with care", d: "Anonymised examples only. We never expose real customer data in marketing." },
];
---
<Layout title="Case Studies" description="Real recovery results from recurring-revenue businesses: illustrative scenarios, process proof and modelled outcomes.">
  <PageHero
    eyebrow="Case studies"
    title="Real recovery results from recurring-revenue businesses"
    sub="See how businesses use Bvive to reduce leakage, recover payments and create a clearer customer management workflow."
    crumb={{ label: "Home", href: "/" }}
  >
    <a href="/book-demo" class="btn btn--primary">Book a Demo <Icon name="arrow" size={17} class="btn__icon" /></a>
  </PageHero>

  <section class="section section--flush-top">
    <div class="container">
      <p class="cs-note" data-reveal><Icon name="eye" size={15} /> The scenarios below are illustrative and modelled from typical recurring-revenue operations. As verified customer results become available, they'll be published here.</p>

      <div class="cs" data-reveal>
        {scenarios.map((s, i) => (
          <article class={`cscard ${i === 0 ? "cscard--wide" : ""}`}>
            <div class="cscard__media"><ProductShot {...shots[s.shot]} glow={false} ratio={i === 0 ? "16 / 9" : "16 / 11"} /></div>
            <div class="cscard__body">
              <span class="pill pill--tint">{s.industry}</span>
              <div class="cscard__metric"><b class="tnum grad-text">{s.metric}</b><span>{s.metricLabel}</span></div>
              <div class="cscard__ba">
                <p><span class="cscard__k cscard__k--b">Before</span> {s.before}</p>
                <p><span class="cscard__k cscard__k--a">With Bvive</span> {s.after}</p>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="heading-block heading-block--center" data-reveal><span class="eyebrow eyebrow--center">Proof you can trust</span><h2>Honest proof, staged as we grow</h2></div>
      <div class="csproof" data-reveal>
        {proof.map((p) => (
          <div class="csproof__card">
            <span class="csproof__ic"><Icon name={p.ic} size={20} /></span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
      <div class="csfirst" data-reveal>
        <div>
          <h3>Be one of our first published case studies</h3>
          <p>Run Bvive in your business and share the results. We'll turn your recovery story into a case study, with your approval on every detail.</p>
        </div>
        <a href="/book-demo" class="btn btn--primary btn--lg">Start with a demo <Icon name="arrow" size={18} class="btn__icon" /></a>
      </div>
    </div>
  </section>

  <CTASection />
</Layout>

<style>
  .cs-note { display: inline-flex; align-items: center; gap: 9px; padding: var(--sp-3) var(--sp-5); background: var(--blue-50); border: 1px solid var(--blue-100); border-radius: var(--r-md); color: var(--blue-700); font-size: var(--text-sm); margin-bottom: var(--sp-6); }
  .cs { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--sp-5); }
  .cscard { overflow: hidden; background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-xl); box-shadow: var(--shadow-xs); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .cscard:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .cscard--wide { grid-column: span 2; display: grid; grid-template-columns: 1.2fr 1fr; }
  .cscard__media :global(.imgslot) { border-radius: 0 !important; border: 0; height: 100%; }
  .cscard__body { padding: var(--sp-6); }
  .cscard__metric { display: flex; align-items: baseline; gap: var(--sp-3); margin: var(--sp-4) 0; }
  .cscard__metric b { font-family: var(--font-display); font-size: var(--text-4xl); letter-spacing: -.03em; }
  .cscard__metric span { font-size: var(--text-sm); color: var(--text-muted); }
  .cscard__ba { display: grid; gap: var(--sp-3); }
  .cscard__ba p { font-size: var(--text-base); color: var(--ink-700); }
  .cscard__k { display: inline-block; font-size: var(--text-xs); font-weight: 700; letter-spacing: .04em; text-transform: uppercase; padding: 2px 8px; border-radius: var(--r-pill); margin-right: 8px; }
  .cscard__k--b { background: var(--ink-100); color: var(--ink-500); }
  .cscard__k--a { background: var(--green-500); color: #fff; }

  .csproof { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-top: var(--sp-8); }
  .csproof__card { padding: var(--sp-6); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); text-align: center; }
  .csproof__ic { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(160deg, var(--blue-50), var(--green-50)); color: var(--blue-600); margin: 0 auto var(--sp-4); }
  .csproof__card h3 { font-size: var(--text-lg); }
  .csproof__card p { margin-top: var(--sp-2); font-size: var(--text-base); color: var(--text-muted); }

  .csfirst { margin-top: var(--sp-8); padding: clamp(1.75rem, 4vw, 2.75rem); background: var(--white); border: 1px solid var(--border); border-radius: var(--r-xl); box-shadow: var(--shadow-sm); display: flex; align-items: center; justify-content: space-between; gap: var(--sp-6); }
  .csfirst h3 { font-size: var(--text-2xl); }
  .csfirst p { margin-top: var(--sp-3); color: var(--text-muted); max-width: 52ch; }

  @media (max-width: 900px) {
    .cs, .csproof { grid-template-columns: 1fr; }
    .cscard--wide { grid-column: span 1; grid-template-columns: 1fr; }
    .csfirst { flex-direction: column; align-items: flex-start; }
  }
</style>
