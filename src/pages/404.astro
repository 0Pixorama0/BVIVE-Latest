---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
const links = [
  { t: "Platform", href: "/platform" },
  { t: "Solutions", href: "/solutions" },
  { t: "Industries", href: "/industries" },
  { t: "Pricing", href: "/pricing" },
];
---
<Layout title="Page not found" description="The page you're looking for can't be found.">
  <section class="nf">
    <span class="nf__bg" aria-hidden="true"></span>
    <div class="container nf__inner">
      <span class="nf__code font-display">404</span>
      <h1>We couldn't find that page</h1>
      <p class="nf__sub">The link may be broken or the page may have moved. Let's get you back on track.</p>
      <div class="nf__cta">
        <a href="/" class="btn btn--primary btn--lg">Back to home <Icon name="arrow" size={18} class="btn__icon" /></a>
        <a href="/book-demo" class="btn btn--ghost btn--lg">Book a Demo</a>
      </div>
      <div class="nf__links">
        {links.map((l) => <a href={l.href}>{l.t} <Icon name="arrow-up-right" size={14} /></a>)}
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf { position: relative; overflow: hidden; padding-block: clamp(4rem, 10vw, 8rem); text-align: center; }
  .nf__bg { position: absolute; inset: 0; background: radial-gradient(50% 60% at 50% 0%, rgba(31,99,232,.08), transparent 60%), linear-gradient(180deg, var(--ink-50), var(--paper)); }
  .nf__inner { position: relative; z-index: 2; max-width: 40rem; margin-inline: auto; }
  .nf__code { display: block; font-size: clamp(5rem, 16vw, 9rem); font-weight: 600; letter-spacing: -.05em; line-height: 1; background: var(--grad-brand); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .nf h1 { margin-top: var(--sp-4); font-size: var(--text-3xl); }
  .nf__sub { margin: var(--sp-4) auto 0; color: var(--text-muted); font-size: var(--text-lg); max-width: 40ch; }
  .nf__cta { display: flex; gap: var(--sp-3); justify-content: center; flex-wrap: wrap; margin-top: var(--sp-7); }
  .nf__links { display: flex; gap: var(--sp-3) var(--sp-5); justify-content: center; flex-wrap: wrap; margin-top: var(--sp-8); padding-top: var(--sp-6); border-top: 1px solid var(--border); }
  .nf__links a { display: inline-flex; align-items: center; gap: 5px; font-size: var(--text-base); font-weight: 600; color: var(--ink-700); }
  .nf__links a:hover { color: var(--blue-600); }
</style>
