---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
const next = [
  { ic: "gauge", t: "Estimate your leakage", d: "Model your recovery opportunity while you wait.", href: "/calculator", cta: "Open calculator" },
  { ic: "grid", t: "Explore the platform", d: "See the modules that recover, retain and report.", href: "/platform", cta: "See platform" },
  { ic: "book", t: "Read the guides", d: "Practical resources on protecting recurring revenue.", href: "/resources", cta: "Browse resources" },
];
---
<Layout title="Thank you" description="Thanks, your request is in. The Bvive team will be in touch shortly.">
  <section class="ty">
    <span class="ty__bg" aria-hidden="true"></span>
    <div class="container ty__inner">
      <span class="ty__check"><Icon name="check" size={34} /></span>
      <h1>Thanks, your request is in</h1>
      <p class="ty__sub">A member of the Bvive team will be in touch shortly to confirm a time and tailor everything to your business. In the meantime, here's where to go next.</p>

      <div class="ty__cards">
        {next.map((n) => (
          <a href={n.href} class="ty__card">
            <span class="ty__ic"><Icon name={n.ic} size={20} /></span>
            <b>{n.t}</b>
            <p>{n.d}</p>
            <span class="ty__go">{n.cta} <Icon name="arrow" size={14} /></span>
          </a>
        ))}
      </div>
      <a href="/" class="link-arrow ty__home"><Icon name="arrow" size={15} class="rot" /> Back to home</a>
    </div>
  </section>
</Layout>

<style>
  .ty { position: relative; overflow: hidden; padding-block: clamp(3rem, 8vw, 6rem); text-align: center; }
  .ty__bg { position: absolute; inset: 0; background: radial-gradient(50% 60% at 50% 0%, rgba(0,146,69,.1), transparent 60%), linear-gradient(180deg, var(--ink-50), var(--paper)); }
  .ty__inner { position: relative; z-index: 2; max-width: 46rem; margin-inline: auto; }
  .ty__check { display: grid; place-items: center; width: 76px; height: 76px; border-radius: 50%; background: var(--grad-recovered); color: #fff; margin: 0 auto var(--sp-6); box-shadow: var(--shadow-lg); }
  .ty h1 { font-size: var(--text-4xl); }
  .ty__sub { margin: var(--sp-5) auto 0; font-size: var(--text-lg); color: var(--text-muted); max-width: 44ch; }
  .ty__cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-top: var(--sp-9); text-align: left; }
  .ty__card { padding: var(--sp-6); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .ty__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .ty__ic { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 13px; background: var(--ink-50); color: var(--blue-600); margin-bottom: var(--sp-4); }
  .ty__card b { font-family: var(--font-display); font-size: var(--text-lg); }
  .ty__card p { margin-top: var(--sp-2); font-size: var(--text-sm); color: var(--text-muted); }
  .ty__go { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--sp-4); font-size: var(--text-sm); font-weight: 600; color: var(--blue-600); }
  .ty__home { margin-top: var(--sp-8); }
  .rot { transform: rotate(180deg); }
  @media (max-width: 820px) { .ty__cards { grid-template-columns: 1fr; } }
</style>
