---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import Calculator from "../components/Calculator.astro";
import CTASection from "../components/CTASection.astro";
const points = [
  { ic: "bolt", t: "Failed payments add up fast", d: "Even a low failure rate on a large recurring base becomes a significant annual figure." },
  { ic: "refresh", t: "Recovery rate is a choice", d: "A consistent, owned workflow recovers far more than ad-hoc manual chasing." },
  { ic: "clock", t: "Admin time is real cost", d: "Every failed payment carries minutes of manual follow-up that automation removes." },
];
---
<Layout title="Revenue Leakage Calculator" description="Estimate what failed payments are costing your recurring-revenue business, and what a consistent recovery workflow could return.">
  <PageHero
    eyebrow="Revenue leakage calculator"
    title="Estimate what failed payments are quietly costing you"
    sub="A directional model to size your recovery opportunity. Nothing is stored; the numbers stay in your browser."
    crumb={{ label: "Home", href: "/" }}
    align="center"
  />
  <Calculator eyebrow="Model your numbers" heading="Adjust the inputs to see your opportunity" />

  <section class="section section--tint">
    <div class="container">
      <div class="heading-block heading-block--center" data-reveal><span class="eyebrow eyebrow--center">What the numbers mean</span><h2>Why the leak is bigger than it looks</h2></div>
      <div class="cpoints" data-reveal>
        {points.map((p) => (
          <div class="cpoint">
            <span class="cpoint__ic"><Icon name={p.ic} size={20} /></span>
            <h3>{p.t}</h3>
            <p>{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection eyebrow="Next step" title="Turn the estimate into recovered revenue" body="Book a demo and we'll validate these numbers against your business and show you the workflow that captures them." />
</Layout>

<style>
  .cpoints { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-top: var(--sp-8); }
  .cpoint { padding: var(--sp-6); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); text-align: center; }
  .cpoint__ic { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(160deg, var(--blue-50), var(--green-50)); color: var(--blue-600); margin: 0 auto var(--sp-4); }
  .cpoint h3 { font-size: var(--text-lg); }
  .cpoint p { margin-top: var(--sp-2); font-size: var(--text-base); color: var(--text-muted); }
  @media (max-width: 820px) { .cpoints { grid-template-columns: 1fr; } }
</style>
