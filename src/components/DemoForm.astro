---
import Icon from "./Icon.astro";
interface Props { compact?: boolean; }
const { compact = false } = Astro.props;
const industries = ["Gym / Fitness","Childcare","Allied health","Education & training","Martial arts / Dance","Membership organisation","Subscription business","NDIS / Service provider","Other"];
const volumes = ["500 – 1,000","1,000 – 2,500","2,500 – 5,000","5,000 – 10,000","10,000+","Under 500"];
---
<form class={`dform ${compact ? "dform--compact" : ""}`} data-demo-form data-endpoint="" novalidate>
  <div class="dform__grid">
    <div class="fld">
      <label for="f-name">Full name <span aria-hidden="true">*</span></label>
      <input id="f-name" name="name" type="text" autocomplete="name" required placeholder="Jordan Smith" />
    </div>
    <div class="fld">
      <label for="f-business">Business name <span aria-hidden="true">*</span></label>
      <input id="f-business" name="business" type="text" autocomplete="organization" required placeholder="Northside Strength Co." />
    </div>
    <div class="fld">
      <label for="f-email">Work email <span aria-hidden="true">*</span></label>
      <input id="f-email" name="email" type="email" autocomplete="email" required placeholder="you@business.com.au" />
    </div>
    <div class="fld">
      <label for="f-phone">Phone <span aria-hidden="true">*</span></label>
      <input id="f-phone" name="phone" type="tel" autocomplete="tel" required placeholder="04xx xxx xxx" />
    </div>
    <div class="fld">
      <label for="f-industry">Industry <span aria-hidden="true">*</span></label>
      <select id="f-industry" name="industry" required>
        <option value="" disabled selected>Select industry</option>
        {industries.map((i) => <option value={i}>{i}</option>)}
      </select>
    </div>
    <div class="fld">
      <label for="f-volume">Recurring customers <span aria-hidden="true">*</span></label>
      <select id="f-volume" name="volume" required>
        <option value="" disabled selected>Select volume</option>
        {volumes.map((v) => <option value={v}>{v}</option>)}
      </select>
    </div>
    <div class="fld fld--full">
      <label for="f-provider">Current payment provider <span class="fld__opt">optional</span></label>
      <input id="f-provider" name="provider" type="text" placeholder="e.g. Ezidebit, GoCardless, in-house" />
    </div>
    <div class="fld fld--full">
      <label for="f-challenge">Biggest challenge right now <span class="fld__opt">optional</span></label>
      <textarea id="f-challenge" name="challenge" rows="3" placeholder="Failed payments, cancellations, admin workload, visibility…"></textarea>
    </div>
  </div>

  <div class="dform__foot">
    <button type="submit" class="btn btn--primary btn--lg">Book my demo <Icon name="arrow" size={18} class="btn__icon" /></button>
    <p class="dform__fine"><Icon name="shield" size={14} /> We'll only use these details to prepare and run your demo. No spam.</p>
  </div>

  <div class="dform__success" hidden data-success>
    <span class="dform__check"><Icon name="check" size={26} /></span>
    <h3>Thanks — your demo request is in.</h3>
    <p>A member of the Bvive team will be in touch shortly to confirm a time and tailor the demo to your business. In the meantime, you can estimate your revenue leakage.</p>
    <a href="/calculator" class="btn btn--dark">Estimate your leakage <Icon name="arrow" size={16} class="btn__icon" /></a>
  </div>
</form>

<style>
  .dform { background: var(--white); border: 1px solid var(--border); border-radius: var(--r-xl); padding: clamp(1.5rem, 3vw, 2.5rem); box-shadow: var(--shadow-md); }
  .dform--compact { box-shadow: var(--shadow-sm); }
  .dform__grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--sp-4); }
  .fld { display: flex; flex-direction: column; gap: 8px; }
  .fld--full { grid-column: 1 / -1; }
  .fld label { font-size: var(--text-sm); font-weight: 600; color: var(--ink-700); display: flex; align-items: center; gap: 6px; }
  .fld label span[aria-hidden] { color: var(--blue-600); }
  .fld__opt { font-weight: 400; color: var(--ink-400); text-transform: none; letter-spacing: 0; }
  .fld input, .fld select, .fld textarea {
    padding: 0.75rem 0.875rem; border: 1px solid var(--border); border-radius: var(--r-md);
    background: var(--paper); font-size: var(--text-base); color: var(--ink-900);
    transition: border-color var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out), background var(--dur);
  }
  .fld input::placeholder, .fld textarea::placeholder { color: var(--ink-300); }
  .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: var(--blue-500); background: var(--white); box-shadow: var(--ring); }
  .fld input:user-invalid, .fld select:user-invalid { border-color: var(--red-500); }
  .fld textarea { resize: vertical; font-family: inherit; }

  .dform__foot { display: flex; align-items: center; gap: var(--sp-5); flex-wrap: wrap; margin-top: var(--sp-6); }
  .dform__fine { display: inline-flex; align-items: center; gap: 7px; font-size: var(--text-sm); color: var(--text-muted); }
  .dform__fine :global(svg) { color: var(--teal-600); }

  .dform__success { text-align: center; padding: var(--sp-6) var(--sp-4); }
  .dform__check { display: grid; place-items: center; width: 60px; height: 60px; border-radius: 50%; background: var(--green-100); color: var(--green-600); margin: 0 auto var(--sp-5); }
  .dform__success h3 { font-size: var(--text-2xl); }
  .dform__success p { max-width: 42ch; margin: var(--sp-3) auto var(--sp-6); color: var(--text-muted); }

  @media (max-width: 560px) { .dform__grid { grid-template-columns: 1fr; } }
</style>

<script>
  function initDemoForm() {
    document.querySelectorAll<HTMLFormElement>("[data-demo-form]").forEach((form) => {
      if (form.dataset.bound) return;
      form.dataset.bound = "1";
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const endpoint = form.dataset.endpoint;
        if (btn) { btn.disabled = true; btn.style.opacity = "0.7"; }
        try {
          if (endpoint) {
            const data = Object.fromEntries(new FormData(form).entries());
            await fetch(endpoint, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });
          }
        } catch (_) { /* fall through to confirmation */ }
        const grid = form.querySelector<HTMLElement>(".dform__grid");
        const foot = form.querySelector<HTMLElement>(".dform__foot");
        const success = form.querySelector<HTMLElement>("[data-success]");
        grid?.setAttribute("hidden", ""); foot?.setAttribute("hidden", "");
        if (success) { success.hidden = false; success.scrollIntoView({ behavior: "smooth", block: "center" }); }
      });
    });
  }
  initDemoForm();
  document.addEventListener("astro:page-load", initDemoForm);
</script>
