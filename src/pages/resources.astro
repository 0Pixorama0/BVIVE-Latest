---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Icon from "../components/Icon.astro";
import ImageSlot from "../components/ImageSlot.astro";
import CTASection from "../components/CTASection.astro";

const featured = {
  cat: "Guide", read: "8 min read",
  title: "The recurring-revenue leak: where direct-debit businesses quietly lose money",
  excerpt: "A practical breakdown of the four gaps — failed payments, arrears, cancellations and follow-up — and how to close each one.",
  label: "Editorial hero image — revenue leak concept, premium and abstract",
};
const articles = [
  { cat: "Failed payments", title: "Why direct debits fail — and a workflow to recover them", read: "6 min" },
  { cat: "Cancellations", title: "Turning cancellation requests into structured saves", read: "5 min" },
  { cat: "Operations", title: "Getting off spreadsheets: a staged rollout for arrears", read: "7 min" },
  { cat: "Retention", title: "The customer lifecycle map for recurring-revenue teams", read: "6 min" },
  { cat: "Analytics", title: "The five numbers every owner should watch weekly", read: "4 min" },
  { cat: "Playbook", title: "Building an accountable follow-up process for your team", read: "8 min" },
];
const magnets = [
  { ic: "check-circle", t: "Revenue leakage checklist", d: "A one-page audit of where your recurring revenue is at risk." },
  { ic: "book", t: "Failed payment recovery guide", d: "A step-by-step playbook for recovering failed direct debits." },
  { ic: "retain", t: "Cancellation save checklist", d: "Approved pathways to turn cancellations into retained customers." },
];
---
<Layout title="Resources" description="Guides for protecting recurring revenue — reduce failed payments, manage cancellations, improve follow-up and build a stronger operation.">
  <PageHero
    eyebrow="Resources"
    title="Guides for protecting recurring revenue"
    sub="Learn how to reduce failed payments, manage cancellations, improve follow-up and build a stronger recurring-revenue operation."
    crumb={{ label: "Home", href: "/" }}
  />

  <section class="section section--flush-top">
    <div class="container">
      <a href="/book-demo" class="featured" data-reveal>
        <div class="featured__media"><ImageSlot label={featured.label} ratio="16 / 10" rounded="0" /></div>
        <div class="featured__body">
          <div class="featured__meta"><span class="pill pill--tint">{featured.cat}</span><span>{featured.read}</span></div>
          <h2>{featured.title}</h2>
          <p>{featured.excerpt}</p>
          <span class="link-arrow">Read the guide <Icon name="arrow" size={16} /></span>
        </div>
      </a>

      <div class="arts" data-reveal>
        {articles.map((a) => (
          <a href="/book-demo" class="art">
            <div class="art__media"><ImageSlot label={`${a.cat} article thumbnail`} ratio="16 / 10" rounded="0" /></div>
            <div class="art__body">
              <div class="art__meta"><span>{a.cat}</span><span class="art__dot"></span><span>{a.read}</span></div>
              <h3>{a.title}</h3>
              <span class="art__go">Read <Icon name="arrow" size={13} /></span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="heading-block" data-reveal><span class="eyebrow">Free downloads</span><h2>Practical tools to size and close the leak</h2></div>
      <div class="magnets" data-reveal>
        {magnets.map((m) => (
          <div class="magnet">
            <span class="magnet__ic"><Icon name={m.ic} size={22} /></span>
            <h3>{m.t}</h3>
            <p>{m.d}</p>
            <a href="/contact" class="btn btn--ghost btn--sm">Download <Icon name="arrow" size={14} class="btn__icon" /></a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTASection eyebrow="Resources" title="Prefer to see it live?" body="A guided demo shows the recovery, arrears and cancellation workflows applied to your business in minutes." />
</Layout>

<style>
  .featured { display: grid; grid-template-columns: 1.2fr 1fr; gap: 0; overflow: hidden; border: 1px solid var(--border-soft); border-radius: var(--r-xl); background: var(--white); box-shadow: var(--shadow-sm); transition: box-shadow var(--dur) var(--ease-out); }
  .featured:hover { box-shadow: var(--shadow-lg); }
  .featured__media :global(.imgslot) { border-radius: 0 !important; border: 0; height: 100%; }
  .featured__body { padding: clamp(1.75rem, 4vw, 3rem); display: flex; flex-direction: column; justify-content: center; }
  .featured__meta { display: flex; align-items: center; gap: var(--sp-3); font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--sp-4); }
  .featured__body h2 { font-size: var(--text-2xl); }
  .featured__body p { margin: var(--sp-4) 0 var(--sp-5); color: var(--text-muted); font-size: var(--text-lg); }

  .arts { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-5); margin-top: var(--sp-6); }
  .art { overflow: hidden; border: 1px solid var(--border-soft); border-radius: var(--r-lg); background: var(--white); box-shadow: var(--shadow-xs); transition: transform var(--dur) var(--ease-out), box-shadow var(--dur); }
  .art:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  .art__media :global(.imgslot) { border-radius: 0 !important; border: 0; border-bottom: 1px solid var(--border-soft); }
  .art__body { padding: var(--sp-5); }
  .art__meta { display: flex; align-items: center; gap: 8px; font-size: var(--text-xs); font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: var(--text-subtle); }
  .art__dot { width: 3px; height: 3px; border-radius: 50%; background: var(--ink-300); }
  .art__body h3 { font-size: var(--text-lg); margin-top: var(--sp-3); }
  .art__go { display: inline-flex; align-items: center; gap: 5px; margin-top: var(--sp-4); font-size: var(--text-sm); font-weight: 600; color: var(--blue-600); }

  .magnets { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-4); margin-top: var(--sp-8); }
  .magnet { padding: var(--sp-7); background: var(--white); border: 1px solid var(--border-soft); border-radius: var(--r-lg); box-shadow: var(--shadow-xs); }
  .magnet__ic { display: grid; place-items: center; width: 50px; height: 50px; border-radius: 14px; background: linear-gradient(160deg, var(--blue-50), var(--teal-50)); color: var(--blue-600); margin-bottom: var(--sp-4); }
  .magnet h3 { font-size: var(--text-lg); }
  .magnet p { margin: var(--sp-2) 0 var(--sp-5); font-size: var(--text-base); color: var(--text-muted); }

  @media (max-width: 900px) {
    .featured { grid-template-columns: 1fr; }
    .arts, .magnets { grid-template-columns: 1fr; }
  }
  @media (min-width: 601px) and (max-width: 900px) { .arts, .magnets { grid-template-columns: 1fr 1fr; } }
</style>
