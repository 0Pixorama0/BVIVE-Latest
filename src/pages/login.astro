---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
import Logo from "../components/Logo.astro";
---
<Layout title="Log in" description="Log in to Bvive to manage revenue recovery, customer workflows and reporting.">
  <section class="lg">
    <div class="lg__aside">
      <span class="lg__bg" aria-hidden="true"></span>
      <div class="lg__aside-in">
        <Logo variant="light" />
        <blockquote>
          <p>One place to see revenue risk and act on it — recovery, arrears, cancellations and reporting, connected.</p>
        </blockquote>
        <ul class="lg__points">
          <li><Icon name="check-circle" size={16} /> Recover failed payments</li>
          <li><Icon name="check-circle" size={16} /> Reduce cancellations</li>
          <li><Icon name="check-circle" size={16} /> Protect recurring revenue</li>
        </ul>
      </div>
    </div>

    <div class="lg__main">
      <div class="lg__card">
        <h1>Log in to Bvive</h1>
        <p class="lg__sub">Access your dashboard to manage revenue recovery, customer workflows and reporting.</p>

        <form class="lg__form" data-login novalidate>
          <div class="fld">
            <label for="l-email">Work email</label>
            <input id="l-email" name="email" type="email" autocomplete="email" required placeholder="you@business.com.au" />
          </div>
          <div class="fld">
            <label for="l-pass">Password</label>
            <input id="l-pass" name="password" type="password" autocomplete="current-password" required placeholder="••••••••" />
          </div>
          <div class="lg__row">
            <label class="lg__remember"><input type="checkbox" /> Remember me</label>
            <a href="/contact" class="lg__forgot">Forgot password?</a>
          </div>
          <button type="submit" class="btn btn--primary btn--block btn--lg">Log in <Icon name="arrow" size={18} class="btn__icon" /></button>
          <p class="lg__hint" data-login-hint hidden>Account access is provided to existing Bvive customers. <a href="/contact">Contact us</a> if you need help signing in.</p>
        </form>

        <p class="lg__new">New to Bvive? <a href="/book-demo">Book a demo</a> to get started.</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .lg { display: grid; grid-template-columns: 1fr 1.1fr; min-height: calc(100vh - var(--nav-h)); }
  .lg__aside { position: relative; overflow: hidden; background: var(--navy-900); color: #cdd8e6; }
  .lg__bg { position: absolute; inset: 0; background: radial-gradient(70% 60% at 30% 10%, rgba(31,99,232,.25), transparent 55%), radial-gradient(60% 60% at 90% 90%, rgba(16,181,166,.2), transparent 55%), linear-gradient(160deg, #071a2e, #050e1c); }
  .lg__aside-in { position: relative; z-index: 2; height: 100%; display: flex; flex-direction: column; padding: clamp(2rem, 4vw, 3.5rem); }
  .lg__aside blockquote { margin-top: auto; }
  .lg__aside blockquote p { font-family: var(--font-display); font-size: var(--text-2xl); font-weight: 400; line-height: 1.35; letter-spacing: -.02em; color: #fff; }
  .lg__points { margin-top: var(--sp-7); display: grid; gap: var(--sp-3); }
  .lg__points li { display: flex; align-items: center; gap: 10px; font-size: var(--text-base); color: #9fb4cb; }
  .lg__points :global(svg) { color: var(--teal-400); }

  .lg__main { display: grid; place-items: center; padding: var(--sp-8) var(--gutter); }
  .lg__card { width: 100%; max-width: 26rem; }
  .lg__card h1 { font-size: var(--text-3xl); }
  .lg__sub { margin-top: var(--sp-3); color: var(--text-muted); }
  .lg__form { margin-top: var(--sp-7); display: grid; gap: var(--sp-4); }
  .fld { display: flex; flex-direction: column; gap: 8px; }
  .fld label { font-size: var(--text-sm); font-weight: 600; color: var(--ink-700); }
  .fld input { padding: 0.8125rem 0.875rem; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--paper); font-size: var(--text-base); transition: border-color var(--dur), box-shadow var(--dur), background var(--dur); }
  .fld input:focus { outline: none; border-color: var(--blue-500); background: var(--white); box-shadow: var(--ring); }
  .lg__row { display: flex; align-items: center; justify-content: space-between; font-size: var(--text-sm); }
  .lg__remember { display: inline-flex; align-items: center; gap: 8px; color: var(--text-muted); }
  .lg__forgot { color: var(--blue-600); font-weight: 600; }
  .lg__hint { font-size: var(--text-sm); color: var(--text-muted); background: var(--ink-50); padding: var(--sp-3) var(--sp-4); border-radius: var(--r-md); }
  .lg__hint a { color: var(--blue-600); font-weight: 600; }
  .lg__new { margin-top: var(--sp-6); text-align: center; font-size: var(--text-base); color: var(--text-muted); }
  .lg__new a { color: var(--blue-600); font-weight: 600; }

  @media (max-width: 820px) {
    .lg { grid-template-columns: 1fr; }
    .lg__aside { display: none; }
  }
</style>

<script>
  function initLogin() {
    document.querySelectorAll<HTMLFormElement>("[data-login]").forEach((f) => {
      if (f.dataset.bound) return; f.dataset.bound = "1";
      f.addEventListener("submit", (e) => {
        e.preventDefault();
        if (!f.checkValidity()) { f.reportValidity(); return; }
        const hint = f.querySelector<HTMLElement>("[data-login-hint]");
        if (hint) hint.hidden = false;
      });
    });
  }
  initLogin();
  document.addEventListener("astro:page-load", initLogin);
</script>
