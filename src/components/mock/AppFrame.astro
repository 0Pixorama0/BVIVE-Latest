---
/* Reusable app-window chrome shared by all product mockups. */
import Logo from "../Logo.astro";
interface Props { class?: string; }
const { class: cls = "" } = Astro.props;
---
<div class={`appframe ${cls}`}>
  <div class="appframe__bar">
    <span class="appframe__dots"><i></i><i></i><i></i></span>
    <Logo href={null} height={18} class="appframe__logo" />
    <span class="appframe__spacer"></span>
  </div>
  <div class="appframe__body">
    <slot />
  </div>
</div>
<style>
  .appframe {
    position: relative;
    z-index: 1;
    background: var(--white);
    border: 1px solid rgba(255,255,255,.14);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
    outline: 1px solid rgba(10,23,37,.06);
  }
  .appframe__bar {
    display: flex; align-items: center; gap: 12px;
    height: 40px; padding: 0 14px;
    background: linear-gradient(180deg, #f7f9fc, #eef2f8);
    border-bottom: 1px solid var(--border);
  }
  .appframe__dots { display: inline-flex; gap: 6px; }
  .appframe__dots i { width: 10px; height: 10px; border-radius: 50%; background: #d3dae4; }
  .appframe__dots i:nth-child(1) { background: #f5726a; }
  .appframe__dots i:nth-child(2) { background: #f6b73c; }
  .appframe__dots i:nth-child(3) { background: #3fc07a; }
  /* The window's identity chip. Static inside a mockup: the breathing aura
     the live nav logo uses would pull focus from the product UI. */
  .appframe :global(.appframe__logo) { margin-inline: auto; }
  .appframe :global(.appframe__logo .logo__aura) { display: none; }
  .appframe__spacer { width: 46px; }
  .appframe__body { background: var(--paper); }
</style>
